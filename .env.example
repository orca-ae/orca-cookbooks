# Copy to .env and fill in. Every recipe reads these; none hardcode IDs or model names.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Connection
# ---------------------------------------------------------------------------

# Host root of your Orca Agent Engine deployment. Do NOT include /v1 or
# /v1/registry — the SDK appends those itself.
#
#   self-hosted engine   http://localhost:8080
#   hosted workspace     the URL of your workspace
ORCA_BASE_URL=http://localhost:8080

# Workspace API key for that deployment.
ORCA_API_KEY=

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Model id to run recipes against. This is deployment-specific:
#
#   self-hosted engine   a model id the provider configured in your engine accepts
#   hosted workspace     one of the ids `ork agent providers list` shows
#
# Recipes that want a cheaper model for delegated work read ORCA_MODEL_FAST and
# fall back to ORCA_MODEL when it is unset.
ORCA_MODEL=
ORCA_MODEL_FAST=

# ---------------------------------------------------------------------------
# Bootstrap
# ---------------------------------------------------------------------------

# Recipes share one environment, created on first run and reused after. The
# model provider must already be configured on the deployment. Change the
# prefix if you want the environment isolated from another checkout.
ORCA_RESOURCE_PREFIX=cookbooks

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# operate-in-production only. Streamable HTTP transport; sse and stdio are
# rejected by the engine. The recipe explains and exits if the URL is unset.
# ORCA_MCP_SERVER_URL=
# ORCA_MCP_SERVER_TOKEN=

# mongodb-atlas only. Unset, the recipe runs against its local fixture instead,
# which the agent cannot distinguish from the real thing.
# MONGODB_URI=
# MONGODB_DB=cookbooks
